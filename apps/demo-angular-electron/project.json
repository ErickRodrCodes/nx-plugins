{
  "name": "demo-angular-electron",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/demo-angular-electron/src",
  "implicitDependencies": ["demo-angular"],
  "targets": {
    "build": {
      "dependsOn": ["^build"]
    },
    "electron": {
      "configurations": {
        "build": {
          "dependsOn": ["^build"],
          "options": {
            "commands": ["nx run demo-angular-electron:build"],
            "parallel": false
          }
        },
        "serve": {
          "dependsOn": ["build"],
          "commands": [
            "nx run demo-angular:serve",
            "nx run demo-angular-electron:serve"
          ],
          "parallel": true
        }
      },
      "executor": "nx:run-commands",
      "defaultConfiguration": "serve"
    },
    "icon": {
      "executor": "@erickrodrcodes/nx-electron-vite:build-icons",
      "defaultConfiguration": "default",
      "options": {
        "hostProject": "demo-angular-electron",
        "hostProjectRoot": "{projectRoot}",
        "iconOutputPath": "dist/apps/demo-angular-electron-icons",
        "mode": "composite"
      },
      "configurations": {
        "app": {
          "mode": "app"
        },
        "setup": {
          "mode": "setup"
        },
        "default": {
          "mode": "composite"
        }
      }
    },
    "dist": {
      "dependsOn": [
        "^build",
        {
          "projects": ["demo-angular-electron"],
          "target": "electron:build"
        },
        {
          "projects": ["demo-angular-electron"],
          "target": "icon"
        }
      ],
      "executor": "@erickrodrcodes/nx-electron-vite:build-electron",
      "options": {
        "hostProject": "demo-angular-electron",
        "guestProject": "demo-angular",
        "hostProjectRoot": "{projectRoot}",
        "mainOutputPath": "dist/apps/demo-angular-electron",
        "mainOutputFileName": "main.mjs",
        "author": "erick",
        "description": "test"
      }
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
