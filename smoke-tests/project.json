{
  "name": "smoke-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "smoke-tests/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/smoke-tests"
      },
      "configurations": {
        "ci": {
          "reporter": ["verbose"]
        }
      }
    },
    "e2e-electron": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test -c electron-e2e/playwright.config.ts",
        "cwd": "smoke-tests"
      }
    }
  }
}
