{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "BuildIcons executor",
  "description": "",
  "type": "object",
  "properties": {
    "hostProject": {
      "type": "string",
      "description": "The host project name",
      "$default": {
        "$source": "projectName"
      },
      "x-dropdown": "projects",
      "x-priority": "important"
    },
    "hostProjectRoot": {
      "type": "string",
      "description": "the relative path of the project root",
      "x-priority": "important"
    },
    "mode": {
      "type": "string",
      "description": "use 'app' to generate the icon for the app. 'setup' for the icon of the installer, 'composite' to generate the icons at the same time",
      "x-priority": "important",
      "enum": ["app", "setup", "composite"]
    }
  },
  "required": ["hostProject", "hostProjectRoot"]
}
