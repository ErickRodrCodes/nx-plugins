import { app, BrowserWindow, ipcMain } from 'electron'
import path, { join } from 'node:path'

/**
 * Main is emitted as CommonJS (`main.cjs`). Use Node's `__dirname` — do not use
 * `import.meta.url` here. Vite/Rolldown CJS transforms have rewritten
 * `fileURLToPath(import.meta.url)` to `fileURLToPath({}.url)` (undefined),
 * which crashes the packaged app at startup.
 */
declare const __dirname: string

// Ensure Single Instance Lock
if (!app.requestSingleInstanceLock()) {
  app.quit()
  process.exit(0)
}

process.env.APP_ROOT = path.join(__dirname, '..');

// 🚧 Use ['ENV_NAME'] avoid vite:define plugin - Vite@2.x
export const VITE_DEV_SERVER_URL = process.env['VITE_DEV_SERVER_URL']
export const MAIN_DIST = path.join(process.env.APP_ROOT, '<%= outputDistFolder %>');
export const RENDERER_DIST = path.join(process.env.APP_ROOT, '<%= guestProject %>');

process.env.VITE_PUBLIC = VITE_DEV_SERVER_URL ? path.join(process.env.APP_ROOT, 'public') : RENDERER_DIST

/**
 * Demo / smoke-testable IPC: the guest calls `window.electronAPI.ping()`, which
 * the preload wraps around this channel. Guests stay Electron-agnostic; the host
 * owns the contract, so every channel needs a named wrapper in
 * `src/preload/preload.ts` before the renderer can reach it.
 */
ipcMain.handle('app:ping', async () => ({
  ok: true as const,
  from: 'main' as const,
  packaged: app.isPackaged,
}))

let win: BrowserWindow | null

function createWindow() {
  const mainWindow = new BrowserWindow({
    width: 1200,
    height: 800,
    icon: path.join(process.env.VITE_PUBLIC, 'electron-vite.svg'),
    webPreferences: {
      nodeIntegration: false,
      contextIsolation: true,
      preload: join(__dirname, process.env.NODE_ENV === 'development' ? 'preload.js' : 'preload.cjs'),
      /**
       * Electron's default since v20 and recommendation #4 of the security
       * checklist. A sandboxed preload may only require 'electron' and a small
       * polyfilled subset of Node — expose privileged work over IPC instead of
       * turning this off.
       */
      sandbox: true
    },
  })

  // Push to the renderer; the guest subscribes via `electronAPI.onMainProcessMessage`.
  mainWindow.webContents.on('did-finish-load', () => {
    mainWindow?.webContents.send('main-process-message', new Date().toLocaleString())
  })

  // In development, use the host url
  if (process.env.NODE_ENV === 'development') {
    mainWindow.loadURL(VITE_DEV_SERVER_URL ?? 'http://localhost:4200')
    mainWindow.webContents.openDevTools()
  } else {
    // In production, load from dist
    mainWindow.loadFile(join(RENDERER_DIST, 'index.html'))
  }

  return mainWindow
}

// Someone tried to run a second instance, we should focus our window instead
app.on('second-instance', () => {
  if (win) {
    // Focus the main window if attempt was made to open another
    if (win.isMinimized()) win.restore()
    win.focus()
  }
})

// Quit when all windows are closed, except on macOS. There, it's common
// for applications and their menu bar to stay active until the user quits
// explicitly with Cmd + Q.
app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') {
    app.quit()
    win = null
  }
})

app.on('activate', () => {
  // On OS X it's common to re-create a window in the app when the
  // dock icon is clicked and there are no other windows open.
  if (BrowserWindow.getAllWindows().length === 0) {
    win = createWindow()
  }
})

app.whenReady().then(() => {
  win = createWindow()

  app.on('activate', function () {
    // On macOS it's common to re-create a window in the app when the
    // dock icon is clicked and there are no other windows open.
    if (BrowserWindow.getAllWindows().length === 0) {
      win = createWindow()
    }
  })
})
