/// <reference types="vite-plugin-electron/electron-env" />

declare namespace NodeJS {
  interface ProcessEnv {
    APP_ROOT: string
    /** test for strict typing: /dist/ or /public/ cannot be a string */
    VITE_PUBLIC: string
  }
}

/** Reply from the `app:ping` handler in `src/main/main.ts`. */
interface AppPingResult {
  ok: true
  from: 'main'
  packaged: boolean
}

/**
 * Surface exposed by `src/preload/preload.ts` via `contextBridge`. This is the
 * contract the guest renderer codes against — keep it in sync with the preload.
 */
interface ElectronAPI {
  ping(): Promise<AppPingResult>
  /** Returns an unsubscribe function. */
  onMainProcessMessage(callback: (message: string) => void): () => void
}

// Exposed on the Renderer process by `preload.ts`
interface Window {
  electronAPI: ElectronAPI
}
