appId: <%= guestProject %>.electron.app
productName: <%= guestProject %>
directories:
  buildResources: build
files:
 - '!**/*'
 - '!<%= outputDistFolder %>/package.json'
 - '<%= guestDistFolder %>'
 - '<%= outputDistFolder %>'
 - '<%= outputDistFolderIcons %>'
asarUnpack:
  - resources/**
  # Native Node addons cannot dlopen from inside asar
  - "**/*.node"
win:
  executableName:  <%= executableName %>
  icon: <%= outputDistFolderIcons %>/icon.ico
  
  # Starting Electron Builder v26.0.0, For winOptions signing configuration, it 
  # has been moved to win.signtoolOptions in order to support azureOptions as a separate field
  # and avoid bloating win configuration object. 
  # For macOptions, notarize options has been deprecated in favor of env vars for quite some time. Env vars are much more secure
  signtoolOptions:
    # IMPORTANT: publisherName must match the CommonName (CN) of your code signing certificate.
    # To avoid an empty publisherName, you must sign the application by using the sign property of signtoolOptions
    publisherName: "<%= author %>"
    sign: <%= directoryResources %>/sign-windows.js

nsis:
  installerIcon: <%= outputDistFolderIcons %>/setup.ico
  artifactName: <%= guestProject %>-${version}-setup.${ext}
  shortcutName: ${productName}
  uninstallDisplayName: ${productName}
  createDesktopShortcut: always
  include: <%= nsisExtraFilePath %>
mac:
  entitlementsInherit: <%= directoryResources %>/entitlements/entitlements.mac.plist
  icon: <%= outputDistFolderIcons %>/icon.icns
  extendInfo:
    - NSCameraUsageDescription: Application requests access to the device's camera.
    - NSMicrophoneUsageDescription: Application requests access to the device's microphone.
    - NSDocumentsFolderUsageDescription: Application requests access to the user's Documents folder.
    - NSDownloadsFolderUsageDescription: Application requests access to the user's Downloads folder.
  notarize: false
dmg:
  artifactName: <%= guestProject %>-${version}.${ext}
linux:
  icon: <%= outputDistFolderIcons %>/icon.ico
  target:
    - AppImage
    - snap
    - deb
  maintainer: electronjs.org
  category: Utility
appImage:
  artifactName: <%= guestProject %>-${version}.${ext}
npmRebuild: false
electronDownload:
  mirror: https://npmmirror.com/mirrors/electron/
<% if(updater === true)  { %>
publish:
  provider: generic
  url: https://{ provide here the url where updates will be read }
<% } %>
