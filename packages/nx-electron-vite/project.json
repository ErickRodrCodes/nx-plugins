{
  "name": "nx-electron-vite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nx-electron-vite/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "currentVersionResolver": "disk",
        "packageRoot": "dist/packages/nx-electron-vite"
      }
    }
  },
  "tags": [],
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "rimraf dist/packages/nx-electron-vite"
      }
    },
    "pre-release": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": ["git config --local core.hooksPath /dev/null"]
      }
    },
    "post-release": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": ["git config --local core.hooksPath .husky/"]
      }
    },
    "release": {
      "executor": "@nx/js:release",
      "cache": false,
      "dependsOn": ["pre-release"],
      "options": {
        "packageRoot": "dist/packages/nx-electron-vite"
      },
      "postTargets": ["post-release"]
    },
    "build": {
      "executor": "@nx/js:tsc",
      "cache": false,
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nx-electron-vite",
        "main": "packages/nx-electron-vite/src/index.ts",
        "tsConfig": "packages/nx-electron-vite/tsconfig.lib.json",
        "assets": [
          "packages/nx-electron-vite/*.md",
          {
            "input": "./packages/nx-electron-vite/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/nx-electron-vite/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/nx-electron-vite",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/nx-electron-vite",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/nx-electron-vite/jest.config.ts"
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "dist/packages/nx-electron-vite"
      }
    },
    "publish": {
      "executor": "@nx/js:release-publish",
      "cache": false,
      "options": {
        "packageRoot": "dist/packages/nx-electron-vite"
      }
    }
  }
}
